{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "appfinanzas-aa642",
          "appId": "1:264954142053:android:4965b5fa1f613f6b4b158c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "appfinanzas-aa642",
          "configurations": {
            "android": "1:264954142053:android:4965b5fa1f613f6b4b158c",
            "ios": "1:264954142053:ios:85ec748af6182fcc4b158c",
            "macos": "1:264954142053:ios:85ec748af6182fcc4b158c",
            "web": "1:264954142053:web:96476372adc464054b158c",
            "windows": "1:264954142053:web:b3958be2b9d871244b158c"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
